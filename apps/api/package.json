{
  "name": "@huddle/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "rm -f test.db && cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "build": "tsc && tsc-alias",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/schema": "^10.1.1",
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.18.0",
    "@scalar/hono-api-reference": "^0.12.3",
    "dotenv": "^18.0.1",
    "dotenv-expand": "^1000.0.0",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "hono": "^4.13.8",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stoker": "2.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@setemiojo/eslint-config": "^9.5.1",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^2.0.1",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
